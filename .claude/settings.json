{
  "permissions": {
    "allow": [
      "Bash(npm run shots *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run check:content *)",
      "Bash(node scripts/shots.mjs *)",
      "Bash(node scripts/check-content.mjs *)",
      "Bash(bash scripts/link-profile.sh *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/think-first.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-content.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking site copy"
          }
        ]
      }
    ]
  }
}
